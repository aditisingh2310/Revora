# Server
PORT=3000

# Supabase (use the project URL + service role key from your Supabase dashboard)
# For local dev you can run `supabase start` and copy the values it prints.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot API token from BotFather (never commit the real value)
TELEGRAM_BOT_TOKEN=
