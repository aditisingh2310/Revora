{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/api-zod": ["../lib/api-zod/src/index.ts"],
      "@workspace/api-zod/*": ["../lib/api-zod/src/*"],
      "@workspace/api-client-react": ["../lib/api-client-react/src/index.ts"],
      "@workspace/api-client-react/*": ["../lib/api-client-react/src/*"],
      "@workspace/db": ["../lib/db/src/index.ts"],
      "@workspace/db/*": ["../lib/db/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
